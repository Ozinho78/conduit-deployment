# ============================================================================
# Conduit Deployment - Environment Configuration
# ============================================================================
# WICHTIG: Kopiere diese Datei zu '.env' und fülle die Werte aus!
#          Die .env Datei wird NICHT ins Git committed!
# ============================================================================

# ----------------------------------------------------------------------------
# PostgreSQL Database (REQUIRED!)
# ----------------------------------------------------------------------------
POSTGRES_DB=conduit
POSTGRES_USER=conduit
POSTGRES_PASSWORD=changeme_secure_password_here

# ----------------------------------------------------------------------------
# Django Backend
# ----------------------------------------------------------------------------
# SECRET_KEY: Generiere mit:
# python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=changeme_generate_secure_key_here

# Debug Mode (NIEMALS True in Production!)
DJANGO_DEBUG=False

# Allowed Hosts (Komma-separiert, KEINE Leerzeichen!)
# Füge deine VM IP hinzu!
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,conduit-backend,YOUR_VM_IP_HERE

# ----------------------------------------------------------------------------
# CORS Configuration
# ----------------------------------------------------------------------------
# Erlaubte Origins für Frontend (Komma-separiert, KEINE Leerzeichen!)
# Füge deine VM IP hinzu!
CORS_ALLOWED_ORIGINS=http://localhost:8282,http://YOUR_VM_IP_HERE:8282

# ----------------------------------------------------------------------------
# Ports
# ----------------------------------------------------------------------------
# Frontend Port (Checklist: 8282!)
FRONTEND_PORT=8282

# Backend API Port
BACKEND_PORT=8000
