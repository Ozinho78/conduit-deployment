# ---------------------------------------------
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
*.crt
id_rsa*
*.ppk
secret/
secrets/
.secret
.secrets

# ---------------------------------------------
# Python
# ---------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
